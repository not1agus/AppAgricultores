NODE_ENV=development
PORT=3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Full base URL of the SIGPAC WFS endpoint (no query string).
# Server-side only — never expose to clients.
# Endpoint oficial del FEGA (Ministerio de Agricultura). Funciona sin API key.
SIGPAC_WFS_URL=https://sigpac.mapama.gob.es/vectorwfs/wfs

# URL del servicio OCR (PaddleOCR sidecar). Dejar vacío para usar Tesseract integrado.
OCR_SERVICE_URL=
OCR_SERVICE_TIMEOUT_MS=30000
